{
  "name": "tierlist-dapp-ether",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:contract": "hardhat compile",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint . --flag unstable_native_nodejs_ts_config",
    "preview": "vite preview",
    "test:contract": "hardhat test solidity --coverage",
    "tierlist:cli": "node --experimental-strip-types scripts/tierlist-manager.ts",
    "insert:tierlist": "pnpm tierlist:cli create"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@metamask/connect-evm": "^2.1.1",
    "@tanstack/react-query": "^5.103.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "viem": "~2.56.8",
    "wagmi": "^3.7.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.6",
    "@nomicfoundation/hardhat-verify": "^3.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "commander": "^15.0.0",
    "daisyui": "^5.7.42",
    "discord-api-types": "^0.38.55",
    "dotenv": "^18.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "hardhat": "^3.17.0",
    "oxc-transform-react": "^0.150.0",
    "oxfmt": "^0.68.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-imagetools": "^12.0.1",
    "vite-plugin-sri-gen": "^1.7.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11",
      "onFail": "ignore"
    },
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "ignore"
    }
  }
}
