{
  "name": "tierlist-dapp-ether",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:contract": "hardhat compile",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint .",
    "preview": "vite preview",
    "test:contract": "hardhat test solidity --coverage",
    "tierlist:cli": "node --experimental-strip-types scripts/tierlist-manager.ts",
    "insert:tierlist": "pnpm tierlist:cli create"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@metamask/connect-evm": "^2.1.1",
    "@tanstack/react-query": "^5.105.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "viem": "~2.57.13",
    "wagmi": "^3.7.9"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.6",
    "@nomicfoundation/hardhat-verify": "^3.1.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "commander": "^15.0.0",
    "daisyui": "^5.7.50",
    "discord-api-types": "^0.38.57",
    "dotenv": "^18.0.9",
    "hardhat": "^3.21.2",
    "oxc-transform-react": "^0.156.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-imagetools": "^12.0.1",
    "vite-plugin-sri-gen": "^1.7.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "ignore"
    },
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "error"
    }
  }
}
