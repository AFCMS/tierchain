{
  "name": "tierlist-dapp-ether",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:contract": "hardhat compile",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint .",
    "preview": "vite preview",
    "test:contract": "hardhat test solidity --coverage",
    "tierlist:cli": "node --experimental-strip-types scripts/tierlist-manager.ts",
    "insert:tierlist": "pnpm tierlist:cli create"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@metamask/connect-evm": "^2.1.1",
    "@tanstack/react-query": "^5.108.4",
    "lucide-react": "^1.82.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "viem": "~2.58.8",
    "wagmi": "^3.7.11"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.1.10",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.6",
    "@nomicfoundation/hardhat-verify": "^3.1.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "commander": "^15.1.0",
    "daisyui": "^5.8.3",
    "discord-api-types": "^0.38.60",
    "dotenv": "^18.0.10",
    "hardhat": "^3.23.0",
    "oxc-transform-react": "^0.156.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2009",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.4.0",
    "vite-imagetools": "^12.0.2",
    "vite-plugin-sri-gen": "^1.7.6"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.16",
      "onFail": "ignore"
    },
    "runtime": {
      "name": "node",
      "version": "^26",
      "onFail": "error"
    }
  }
}
